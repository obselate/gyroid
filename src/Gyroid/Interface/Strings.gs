            case "Unload the wallet before stopping or restarting the node": "请先关闭钱包，再停止或重启节点。"
            case "Installed wallet file must have a parent directory": "已安装的钱包文件须位于有效目录中"
            case "Running core network does not match the configured network": "运行中的节点网络与设置不一致"
            case "Wallet name must be a basename ending in .dat": "钱包名称须以 .dat 结尾，且不能包含目录。"
            case "Application executable is unavailable": "无法获取应用程序路径"
            case "File ownership could not be verified": "无法验证文件所有者"
            case "Core process arguments could not be verified": "无法验证节点进程参数"
            case "Could not allocate the owned core console": "无法为节点进程分配控制台"
            case "Could not register the owned core console handler": "无法注册节点控制台处理程序"
            case "Could not schedule wallet auto-lock": "无法安排钱包自动锁定"
            default: key
        }
    }

    shared {
        func Resolve(language string) string {
            if language == "en" || language == "zh-Hans" {
                return language
            }
            let culture = CultureInfo.CurrentUICulture.Name
            if culture.Equals("zh-CN", StringComparison.OrdinalIgnoreCase) || culture.Equals(
                "zh-SG",
                StringComparison.OrdinalIgnoreCase
            ) ||
                culture.StartsWith("zh-Hans", StringComparison.OrdinalIgnoreCase) {
                return "zh-Hans"
            }
            if culture.Length == 0 && OperatingSystem.IsLinux() {
                for name in[]string{"LC_ALL", "LC_MESSAGES", "LANG"} {
                    let value = Environment.GetEnvironmentVariable(name) ?? ""
                    if value.Length == 0 {
                        continue
                    }
                    return if value.StartsWith("zh_CN", StringComparison.OrdinalIgnoreCase) || value.StartsWith(
                        "zh_SG",
                        StringComparison.OrdinalIgnoreCase
                    ) {
                        "zh-Hans"
                    } else {
                        "en"
                    }
                }
            }
            return "en"
        }
    }
}
