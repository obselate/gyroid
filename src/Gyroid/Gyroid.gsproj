<Project Sdk="Gsharp.NET.Sdk/0.5.212">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.2.6</Version>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gyroid</RootNamespace>
    <AssemblyName>Gyroid</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**/*.gs" Exclude="bin/**;obj/**" />
    <EmbeddedResource Include="assets/gyroid.png" LogicalName="Gyroid.Icon.png" />
    <EmbeddedResource Include="assets/gyroid-tray.rgba" LogicalName="Gyroid.Tray.rgba" />
    <EmbeddedResource Include="assets/checkpoints-mainnet.dat" LogicalName="Gyroid.Checkpoints.Mainnet" />
    <EmbeddedResource Include="assets/fonts/JetBrainsMono-Regular.ttf" LogicalName="Gyroid.Font.Regular.ttf" />
    <EmbeddedResource Include="assets/fonts/JetBrainsMono-Bold.ttf" LogicalName="Gyroid.Font.Bold.ttf" />
    <EmbeddedResource Include="assets/oasst1/text-model.bin" LogicalName="Gyroid.TextModel.bin" />
    <None Include="assets/oasst1/LICENSE;assets/oasst1/NOTICE" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/oasst1/%(Filename)%(Extension)" />
    <GooShaderEffect Include="assets/background.slang" SourceIndependent="true" />
    <EmbeddedResource Include="$(GooShaderEffectIntermediateRoot)/$([MSBuild]::StableStringHash($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'assets', 'background.slang')), 'Sha256'))/true/background.goo-effect" LogicalName="Gyroid.Background.goo-effect" />
    <PackageReference Include="Goo" Version="[0.26.0]" />
    <PackageReference Include="Goo.Accessibility" Version="[0.26.0]" />
    <PackageReference Include="Goo.Widgets" Version="[0.18.0]" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="[3.1.0]" />
    <PackageReference Include="NSec.Cryptography" Version="[26.4.0]" />
  </ItemGroup>
  <ItemGroup>
    <GooMaterialIcon Include="account_balance_wallet;add;alternate_email;arrow_back;arrow_upward;build;cancel;chat_bubble;check;check_circle;chevron_left;chevron_right;close;content_copy;delete;description;diamond;dns;done;done_all;download;draft;edit;expand_less;expand_more;folder;grid_view;group;group_add;hardware;info;key;lock;menu_book;north_east;notes;open_in_full;person;person_add;play_arrow;public;replay;schedule;settings;share;south_west;stop;sync;tune;visibility;visibility_off;warning" />
  </ItemGroup>
</Project>
